<?xml version="1.0" encoding="UTF-8"?>
<!--
  StringCheese Java bench adapter.

  Fifth adapter after Rust, Python, JavaScript, and Go. Loads the
  StringCheese WebAssembly component produced by
  `cargo component build (release)` in ../../component/rust-host/ and
  benchmarks it against two ecosystem-native pure-Java string-distance
  libraries: Apache commons-text and info.debatty/java-string-similarity.

  Runtime choice: Chicory (dylibso/chicory).
  Chicory is the pure-Java, no-JNI WebAssembly runtime; it mirrors the
  ethos of wazero on the Go side of this subtree. The alternative
  wasmtime-java would need a platform-native library on PATH plus JNI
  wiring, which contradicts the "works on every JDK a plain `mvn test`
  runs on" property we want here.

  Chicory 1.7.3 executes core wasm modules; it does not (yet) execute
  Component Model wasm directly. We work around that identically to
  the Go adapter: shell out to `wasm-tools component unbundle` on
  first construction to extract the algorithm-kernel core module out
  of the component, then run that core module in Chicory with
  Chicory's built-in WASI preview 1 imports satisfying the module's
  `wasi_snapshot_preview1` imports.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stringcheese.bench</groupId>
    <artifactId>stringcheese-bench-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>StringCheese Java Bench Adapter</name>
    <description>
        StringCheese WebAssembly component loaded via Chicory, benched
        head-to-head against apache-commons-text and
        info.debatty/java-string-similarity.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- Pinned dep versions. Bump each field in one place. -->
        <chicory.version>1.7.3</chicory.version>
        <commons-text.version>1.13.1</commons-text.version>
        <java-string-similarity.version>2.0.0</java-string-similarity.version>
        <jmh.version>1.37</jmh.version>
        <junit.version>5.10.4</junit.version>

        <!-- The JMH main class run through exec-maven-plugin. Test
             scope so the JMH runner sees both benchmarks and the
             adapter classes at exec time. -->
        <jmh.main.class>org.openjdk.jmh.Main</jmh.main.class>

        <!-- Extra CLI args forwarded to JMH's Main. Override on the
             command line with -Djmh.args="Levenshtein -i 1 -wi 1 -f 1"
             etc. Default matches the "quick sanity run" the README
             documents. -->
        <jmh.args>-h</jmh.args>
    </properties>

    <dependencies>
        <!-- ================================================================
             Runtime — Chicory pure-Java wasm runtime + WASI preview1 shim.
             The runtime, wasm parser, and WASI modules are pinned to the
             same 1.7.3 line and shipped in ImportValues at StringCheese
             construction time.
             ================================================================ -->
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>runtime</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>wasm</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>wasi</artifactId>
            <version>${chicory.version}</version>
        </dependency>

        <!-- ================================================================
             Test — JUnit 5 for smoke tests, JMH for benchmarks, the two
             ecosystem string-distance libraries for head-to-head cells.
             ================================================================ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>${commons-text.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>info.debatty</groupId>
            <artifactId>java-string-similarity</artifactId>
            <version>${java-string-similarity.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Wire the JMH annotation processor for test compilation.
                 Placing the benchmarks under src/test/java keeps them
                 out of any downstream consumer's classpath (test scope)
                 while still letting @Benchmark be picked up. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JUnit 5 runner. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!-- `mvn -o exec:exec` runs JMH's Main in a subprocess
                 with the full test classpath, so JMH's own forked-JVM
                 model can find every class it needs (Chicory,
                 commons-text, java-string-similarity, plus the
                 generated JMH BenchmarkList).

                 Using exec:exec (not exec:java) is load-bearing: JMH
                 reads `java.class.path` from the current JVM to
                 construct the fork's classpath. Under exec:java, that
                 property is Maven's own bootstrap classpath, not the
                 project test classpath, so the fork errors out with
                 ClassNotFoundException: org.openjdk.jmh.runner.ForkedMain.
                 exec:exec spawns java(1) with an explicit `-classpath
                 <test classpath>` and side-steps the whole issue.

                 See README "Run the benchmarks" for the canonical
                 invocation and the `-f 0` fallback for exec:java. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>java</executable>
                    <classpathScope>test</classpathScope>
                    <!-- commandlineArgs is a single space-tokenised
                         string; use it instead of <arguments> so
                         user-supplied JMH flags in ${jmh.args} split
                         into individual argv entries rather than
                         landing as one huge argument to Main. The
                         `%classpath` token expands to exec-maven's
                         computed test-scope classpath. -->
                    <commandlineArgs>-classpath %classpath ${jmh.main.class} ${jmh.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
